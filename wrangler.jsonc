// Della Worker configuration.
// The top level is the LOCAL development environment. Staging and production
// declare every binding explicitly because Wrangler does not inherit bindings
// (d1_databases, queues, vars) into named environments.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "della-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_ENV": "development",
    "OWNER_DISPLAY_NAME": "Dhruv",
    "OWNER_TIMEZONE": "America/Los_Angeles",
    "SMS_PROVIDER": "simulated",
    "VOICE_PROVIDER": "simulated",
    "CALENDAR_PROVIDER": "simulated",
    "AI_PROVIDER": "simulated",
    "OPENAI_MODEL": "gpt-6-luna",
    "SMS_LIVE_ENABLED": "false",
    "SMS_ELIGIBILITY_CONFIRMED": "false",
    "VOICE_LIVE_ENABLED": "false",
    "AI_LIVE_ENABLED": "false",
    "CALENDAR_WRITES_ENABLED": "false",
    "DRY_RUN": "true",
    "SIMULATOR_ENABLED": "true",
    "MEDIA_STORE": "local",
    "VISION_PROVIDER": "simulated",
    "EMBEDDING_PROVIDER": "simulated",
    "SEMANTIC_INDEX": "d1",
    "EMAIL_PROVIDER": "simulated",
    "INFO_PROVIDER": "simulated",
  },
  // Private media bucket (no public access, no custom domain). Local dev uses the D1-backed fake.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "della-media-dev" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "della-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "della-jobs-dev" }],
    "consumers": [
      {
        "queue": "della-jobs-dev",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "della-jobs-dlq-dev",
      },
      {
        "queue": "della-jobs-dlq-dev",
        "max_batch_size": 1,
        "max_concurrency": 1,
      },
    ],
  },
  "env": {
    "staging": {
      "name": "della-staging",
      "workers_dev": true,
      // One public origin only (webhook signatures are checked against PUBLIC_BASE_URL).
      "preview_urls": false,
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "APP_ENV": "staging",
        "OWNER_DISPLAY_NAME": "Dhruv",
        "OWNER_TIMEZONE": "America/Los_Angeles",
        "SMS_PROVIDER": "simulated",
        "VOICE_PROVIDER": "simulated",
        "CALENDAR_PROVIDER": "google",
        "AI_PROVIDER": "openai",
        "OPENAI_MODEL": "gpt-6-luna",
        "SMS_LIVE_ENABLED": "false",
        "SMS_ELIGIBILITY_CONFIRMED": "false",
        "VOICE_LIVE_ENABLED": "false",
        "AI_LIVE_ENABLED": "true",
        "CALENDAR_WRITES_ENABLED": "false",
        "DRY_RUN": "true",
        "SIMULATOR_ENABLED": "true",
        "MEDIA_STORE": "r2",
        "VISION_PROVIDER": "simulated",
        "EMBEDDING_PROVIDER": "simulated",
        "SEMANTIC_INDEX": "d1",
        "EMAIL_PROVIDER": "simulated",
        "INFO_PROVIDER": "simulated",
      },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "della-media-staging" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "della-staging",
          "database_id": "4958e912-064f-4347-8861-4efca6c2680b",
          "migrations_dir": "migrations",
        },
      ],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "della-jobs-staging" }],
        "consumers": [
          {
            "queue": "della-jobs-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 1,
            "dead_letter_queue": "della-jobs-dlq-staging",
          },
          {
            "queue": "della-jobs-dlq-staging",
            "max_batch_size": 1,
            "max_concurrency": 1,
          },
        ],
      },
    },
    "production": {
      "name": "della",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "APP_ENV": "production",
        "OWNER_DISPLAY_NAME": "Dhruv",
        "OWNER_TIMEZONE": "America/Los_Angeles",
        "SMS_PROVIDER": "simulated",
        "VOICE_PROVIDER": "simulated",
        "CALENDAR_PROVIDER": "simulated",
        "AI_PROVIDER": "simulated",
        "OPENAI_MODEL": "gpt-6-luna",
        "SMS_LIVE_ENABLED": "false",
        "SMS_ELIGIBILITY_CONFIRMED": "false",
        "VOICE_LIVE_ENABLED": "false",
        "AI_LIVE_ENABLED": "false",
        "CALENDAR_WRITES_ENABLED": "false",
        "DRY_RUN": "true",
        "SIMULATOR_ENABLED": "false",
        "MEDIA_STORE": "r2",
        "VISION_PROVIDER": "simulated",
        "EMBEDDING_PROVIDER": "simulated",
        "SEMANTIC_INDEX": "d1",
        "EMAIL_PROVIDER": "simulated",
        "INFO_PROVIDER": "simulated",
      },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "della-media-production" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "della-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
          "migrations_dir": "migrations",
        },
      ],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "della-jobs-production" }],
        "consumers": [
          {
            "queue": "della-jobs-production",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 1,
            "dead_letter_queue": "della-jobs-dlq-production",
          },
          {
            "queue": "della-jobs-dlq-production",
            "max_batch_size": 1,
            "max_concurrency": 1,
          },
        ],
      },
    },
  },
}
